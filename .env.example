PORT=3000
NODE_ENV=development
# Set a long random secret in production. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret
STORAGE_DIR=./storage
ALLOW_TEST_LOGIN=false

# Cloud persistence: set all three together. Server secrets only.
# Use the Supabase session pooler connection string.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos
# Optional trusted CA as PEM; escaped newline sequences are also accepted.
DATABASE_SSL_CA=
# Cloud defaults to no demo data; local defaults to seed once.
# SEED_DEMO_PHOTOS=false
